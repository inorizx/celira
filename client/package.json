{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-tokens.mjs && node scripts/check-no-host.mjs && node scripts/check-fixtures-imports.mjs && node scripts/check-voice.mjs && node scripts/check-scroll-areas.mjs && node scripts/check-tests-nonempty.mjs",
    "check:boundary": "node ../scripts/check-boundary.mjs",
    "check:docs": "node ../scripts/check-docs.mjs",
    "check:honesty": "node ../scripts/check-doc-honesty.mjs",
    "check:current": "node ../scripts/check-doc-current.mjs",
    "test": "node --test --experimental-strip-types \"tests/*.test.ts\"",
    "preview": "vite preview",
    "shots:catalog": "node scripts/screenshot-catalog.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:ui:app": "node --experimental-strip-types scripts/verify-ui-app.mjs",
    "probe": "node --experimental-strip-types scripts/probe.mjs",
    "verify": "npm run check:boundary && npm run check:docs && npm run check:honesty && npm run check:current && npm run lint && npm test && npm run build && npm run probe -- sweep && node scripts/screenshot-catalog.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.2",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
