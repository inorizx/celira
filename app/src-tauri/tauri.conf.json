{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Celira",
  "version": "0.1.2",
  "identifier": "com.celira.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../client run dev",
    "beforeBuildCommand": "cargo build --release --manifest-path ../Cargo.toml && cargo build --release --manifest-path ../agent/Cargo.toml && npm --prefix ../client run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Celira",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' blob: data: http: https:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../target/release/celira-im.exe": "bin/celira-im.exe",
      "../../agent/target/release/agent_host.exe": "bin/agent_host.exe",
      "../../agent/target/release/agent_run.exe": "bin/agent_run.exe",
      "../../agent/target/release/agent_host_status.exe": "bin/agent_host_status.exe"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
